# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.
#
# With none of these set, the app still works: the plan is saved in the
# browser (localStorage) and "Organise" splits a note into one idea per line.

# Cloud saving and AI organising only switch on once the app is locked,
# either with Google sign-in (preferred) or a passcode.

# Google sign-in. All four must be set. Create the OAuth client at
# console.cloud.google.com → APIs & Services → Credentials (Web application),
# with redirect URI https://<your-domain>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed to open the plan.
ALLOWED_EMAILS=
# Long random string that signs the login cookie: openssl rand -base64 32
SESSION_SECRET=
# Optional: force the site address used for the redirect URI (e.g. https://plan.example.com)
# APP_URL=

# Passcode lock, used only when Google sign-in isn't set up. Anyone who
# knows it can edit the plan, so pick something long.
APP_PASSCODE=

# Cloud saving (same plan on every device). Add Upstash Redis from
# Vercel → Storage / Marketplace and these are filled in for you.
# Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# AI organising of notes into dated plan items (console.anthropic.com).
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5
